---
export const prerender = false;

/**
 * A blog post that is not public.
 *
 * One entrypoint serves every gated post. The integration injects a route per
 * post at that post's own URL, so nothing about the address changes when a
 * post is gated — and this page works out which post it is from the path it
 * was reached on.
 *
 * A member entitled to it gets the post exactly as BlogLayout renders it. A
 * visitor who is not gets the title, the date and the description, with a way
 * to sign in. The body is not sent: it is never put in the response at all,
 * rather than hidden with CSS.
 */

import BlogLayout from '@/layouts/BlogLayout.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import PostLink from '@/components/blog/PostLink.astro';
import { getCollection, render } from 'astro:content';
import { getPostUrl } from '@/lib/blog';
import { formatDate } from '@/lib/utils';
import membersConfig from '@/config/members.config';
import { readSession } from '@/lib/members/session';
import { canRead, accessOf, isGated, isVisible } from '@/lib/members/gating';
import { t, getLocaleFromPath } from '@/i18n';

const path = Astro.url.pathname.replace(/\/$/, '');

const posts = await getCollection('blog', ({ data }) =>
  import.meta.env.PROD ? data.draft !== true : true
);
const post = posts.find(
  (entry) => getPostUrl(entry.id, entry.data.locale).replace(/\/$/, '') === path
);

// The route was injected for a gated post; if the content changed underneath
// it, say not found rather than guessing.
if (!post || !isGated(post.data) || !isVisible(post.data)) {
  return new Response('Not found', { status: 404 });
}

const session = await readSession(Astro.cookies);
const allowed = canRead(session, post.data);
const required = accessOf(post.data);

const rendered = allowed ? await render(post) : null;
const signInUrl = `${membersConfig.prefix}/login`;
const locale = getLocaleFromPath(Astro.url.pathname);
---

{
  allowed && rendered ? (
    <BlogLayout
      title={post.data.title}
      description={post.data.description}
      publishedAt={post.data.publishedAt}
      updatedAt={post.data.updatedAt}
      author={post.data.author}
      image={post.data.image}
      imageAlt={post.data.imageAlt}
      svgSlug={post.data.svgSlug}
      tags={post.data.tags}
      slug={post.id}
      uid={post.data.uid}
      faqs={post.data.faqs}
      headings={rendered.headings}
      toc={post.data.toc}
      comments={post.data.comments}
      body={post.body}
    >
      <rendered.Content components={{ PostLink }} />
    </BlogLayout>
  ) : (
    /* noindex: the teaser below is thin, and a crawler indexing it would list
       a page that says almost nothing. The listing card carries the same
       words on a page that is indexed. */
    <PageLayout title={post.data.title} description={post.data.description} noindex>
      <section class="py-[var(--space-section-md)]">
        <div class="mx-auto w-full max-w-2xl px-6 flex flex-col gap-6">
          {/* Pill, then the date on its own line, then the heading and the
              description — all centred on the card below, which carries the
              same axis. */}
          <div class="flex flex-col items-center gap-3 text-center">
            <Badge variant="brand" pill>
              <Icon name="lock" size="sm" />
              {required === 'members' ? t('members.membersOnly', locale) : required}
            </Badge>
            <time
              datetime={post.data.publishedAt.toISOString()}
              class="text-sm text-foreground-muted"
            >
              {formatDate(post.data.publishedAt)}
            </time>
            <h1 class="font-display text-3xl md:text-4xl font-bold text-foreground text-balance">
              {post.data.title}
            </h1>
            <p class="text-lg text-foreground-muted text-balance">{post.data.description}</p>
          </div>

          <Card variant="elevated" padding="lg">
            <div class="flex flex-col items-center gap-4 text-center">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-brand-500/12 text-brand-500">
                <Icon name="lock" size="lg" />
              </span>
              <h2 class="font-display text-xl font-semibold text-foreground">
                {session
                  ? t('members.notEntitledHeading', locale)
                  : t('members.lockedHeading', locale)}
              </h2>
              <p class="text-foreground-muted text-balance">
                {session
                  ? t('members.notEntitledBody', locale, { tier: required ?? '', email: session.sub })
                  : t('members.lockedBody', locale)}
              </p>
              {!session && (
                <Button href={signInUrl} size="lg">
                  {t('members.signIn', locale)}
                  <Icon name="arrow-right" size="sm" />
                </Button>
              )}
            </div>
          </Card>

          <p class="text-center text-sm text-foreground-subtle">
            <a href="/blog" class="hover:text-foreground transition-colors">
              {t('members.backToBlog', locale)}
            </a>
          </p>
        </div>
      </section>
    </PageLayout>
  )
}
