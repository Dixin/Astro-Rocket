---
/**
 * BlogCta — the block that closes every blog surface.
 *
 * It replaced "Follow along", which offered RSS, the social accounts, an email
 * link and a signup form. Every one of those now sits in the footer, on every
 * page rather than on the blog alone, so the block was repeating what a reader
 * already had a screen further down.
 *
 * What the end of a post can do that a footer cannot is ask for something. The
 * wording and the single-button shape are the about page's, so this reads as
 * the same invitation wherever someone meets it; the copy is `blog.cta` in the
 * locale files, which makes changing it a content change.
 *
 * The arrangement is the one the old block used — a plain CTA on a phone, the
 * LetterGlitch band from `md` up — because that was already carrying this slot
 * on every blog page and there is no reason to move it.
 */
import CTA from '@/components/ui/marketing/CTA/CTA.astro';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import siteConfig from '@/config/site.config';
import { t } from '@/i18n';

interface Props {
  locale: string;
  /** Render the desktop LetterGlitch band beneath the mobile CTA. */
  glitchBand?: boolean;
  /** Classes for the mobile CTA element. */
  ctaClass?: string;
  /** Classes for the section wrapping the desktop band. */
  bandSectionClass?: string;
  /** Inner width of the desktop band. Matches LetterGlitchBand's own prop. */
  bandMaxWidth?: '6xl' | '7xl';
}

const { locale, glitchBand = true, ctaClass, bandSectionClass, bandMaxWidth } = Astro.props;

/**
 * The repo, taken from the site's own links so a fork points at its own rather
 * than at this one. Falls back to the theme's repository.
 */
const repoUrl =
  siteConfig.socialLinks.find((url) => url.includes('github.com')) ??
  'https://github.com/hansmartensdev/astro-rocket';
---

<CTA variant="default" size="md" maxWidth="lg" glow={false} data-reveal class={ctaClass}>
  <h2 slot="heading" class="!text-4xl">{t('blog.cta.heading', locale)}</h2>
  <p slot="description" class="!text-lg text-balance">{t('blog.cta.description', locale)}</p>

  <div class="flex justify-center">
    <Button
      size="lg"
      href={repoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="gap-2 cta-btn-brand"
    >
      <Icon name="github" size="sm" />
      {t('blog.cta.button', locale)}
    </Button>
  </div>
</CTA>

{glitchBand && (
  <section class={bandSectionClass}>
    <LetterGlitchBand maxWidth={bandMaxWidth}>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        {t('blog.cta.heading', locale)}
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        {t('blog.cta.description', locale)}
      </p>

      <div class="flex justify-center">
        <Button
          size="lg"
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="gap-2 hero-btn-brand"
        >
          <Icon name="github" size="sm" />
          {t('blog.cta.button', locale)}
        </Button>
      </div>
    </LetterGlitchBand>
  </section>
)}
