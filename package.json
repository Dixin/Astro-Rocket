{
  "name": "astro-rocket",
  "version": "2.5.3",
  "packageManager": "pnpm@10.33.0",
  "description": "Astro Rocket — A production-ready Astro 7 theme built on Tailwind CSS v4",
  "type": "module",
  "author": "Beyond.ms",
  "license": "MIT",
  "keywords": [
    "astro",
    "astro-theme",
    "theme",
    "tailwind",
    "tailwindcss",
    "typescript",
    "blog",
    "starter",
    "boilerplate",
    "seo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dixin/astro-rocket"
  },
  "homepage": "https://github.com/Dixin/astro-rocket#readme",
  "bugs": {
    "url": "https://github.com/Dixin/astro-rocket/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:netlify": "DEPLOY_TARGET=netlify astro build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare astro build",
    "verify": "node scripts/verify-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm lint && pnpm check && pnpm test:run && pnpm build && pnpm verify",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/mdx": "8.1.2",
    "@astrojs/netlify": "^8.2.10",
    "@astrojs/react": "7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.17",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@iconify-json/lucide": "^1.2.149",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify/react": "^6.0.3",
    "astro": "7.4.4",
    "astro-icon": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fontkit": "^2.0.4",
    "lucide-react": "^0.563.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.36.0",
    "schema-dts": "^1.1.5",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "^9.39.5",
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xberg-io/html-to-markdown": "^3.19.0",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^15.15.0",
    "google-news-url-decoder": "^1.2.2",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sync-fetch": "^0.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7",
    "wrangler": "4.154.0",
    "zhconvert.ts": "^1.0.0",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
